#!/usr/bin/env python3
"""argo — unified search CLI. Usage: argo <subcommand> [args...]

本文件**必须保持 Python 3.8+ 可执行**：它是 entrypoint，会先被
`/usr/bin/env python3` 解释一次（macOS 上就是 3.9），然后才轮到
`_pick_python()` 去挑更高版本的解释器。因此这里禁止使用
`X | None` 之类的 3.10+ 语法——它不是注解解析问题，而是在
函数定义求值期就抛 TypeError，让「选解释器」的兜底逻辑根本没机会执行。
（历史 bug：`def _engine_count() -> int | None:` 让 `argo --help`
在系统 python3 下直接崩在 import 阶段。）
"""

from __future__ import annotations

import sys, os, json, subprocess, shutil

ARGO_HOME = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SCRIPTS = os.path.join(ARGO_HOME, "scripts")


# 解释器探测结果缓存。探测必须在子进程里真 import 依赖才敢用，
# 实测一次约 80–170 ms，而这是**每次** argo 调用都要付的固定成本。缓存命中时
# 只做一次「版本 + 依赖存在性」的廉价校验（find_spec 不 import，约 15 ms），
# 用它挡住解释器被删/降级/换版本的情况。
#
# 探测的依赖只认 PyYAML（argo 唯一的必需第三方依赖，install.sh 装它）。
# 此前还要求 requests——那是历史误留下的幽灵依赖：全仓没有任何
# `import requests`（真实的可选增强是 curl_cffi，TLS 指纹用，缺了只是降级）。
# 后果是新机器（照 install.sh 装完）里 6 个候选解释器全部探测失败、缓存
# 永远不命中，每次调用白付一遍探测；若系统 python3 是 3.9 还会被选中后崩在
# `X | None` 语法上。
_PY_CACHE = os.path.join(
    os.environ.get("ARGO_STATE_DIR", "").strip()
    or os.path.expanduser("~/.cache/unified-search"),
    ".argo_python",
)

# 廉价校验：版本 ≥ 3.10（脚本用了 `X | None` 语法）且 PyYAML 可被定位。
# 用 find_spec 而非 import——存在性足以挡住缓存失效，而 import 正是探测成本
# 的大头。
_PY_CHEAP_CHECK = (
    "import sys, importlib.util as u; sys.exit(0 if sys.version_info >= (3, 10) "
    "and u.find_spec('yaml') is not None else 1)"
)


def _probe_python(py, strict: bool) -> bool:
    """strict=True 真 import 依赖（首次探测）；False 只做廉价存在性校验。

    py 既可以是可执行文件路径，也可以是**参数列表**（Windows 官方启动器
    `py -3` 的形式——它本身不是解释器，要带参数才会选版本）。
    """
    code = "import yaml" if strict else _PY_CHEAP_CHECK
    argv = [py] if isinstance(py, str) else list(py)
    if not argv:
        return False
    try:
        r = subprocess.run(argv + ["-c", code], capture_output=True, timeout=10)
        return r.returncode == 0
    except Exception:
        return False


def _resolve_launcher(argv: list[str]) -> str:
    """把「启动器 + 参数」（如 Windows 的 `py -3`）解析成真实解释器绝对路径。

    缓存与 execv 都只认单个绝对路径，所以必须在探测阶段就把启动器展开一次：
    否则写进缓存的是 `py -3` 这样的组合，`_cached_python` 的 `os.path.isabs`
    校验会直接判它不可用，缓存永远不命中。
    """
    try:
        r = subprocess.run(argv + ["-c", "import sys; print(sys.executable)"],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return ""
    if r.returncode != 0:
        return ""
    lines = [ln.strip() for ln in (r.stdout or "").splitlines() if ln.strip()]
    p = lines[-1] if lines else ""
    return p if p and os.path.isabs(p) else ""


def _cached_python() -> str:
    """读缓存的解释器绝对路径；不可用/校验不过返回空串。"""
    try:
        with open(_PY_CACHE, "r", encoding="utf-8") as f:
            p = f.read().strip()
    except OSError:
        return ""
    if p and os.path.isabs(p) and os.access(p, os.X_OK) and _probe_python(p, False):
        return p
    return ""


def _remember_python(p: str) -> None:
    """原子写入缓存；失败静默（只读环境下退回每次探测的老行为）。"""
    try:
        d = os.path.dirname(_PY_CACHE)
        if d:
            os.makedirs(d, exist_ok=True)
        tmp = "%s.tmp.%d" % (_PY_CACHE, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(p)
        os.replace(tmp, _PY_CACHE)
    except OSError:
        pass


def _pick_python() -> str:
    """选择可用解释器：ARGO_PYTHON 优先，其次高版本 python3.x，兜底当前解释器。

    背景：macOS 默认 /usr/bin/python3 是 3.9，而 argo 脚本用了 3.10+ 语法
    （如 `X | None` 联合类型），3.9 会报 TypeError。逐个探测版本并验证
    PyYAML 依赖后选第一个可用的。

    探测结果落盘缓存（见 _PY_CACHE）：命中时不再起子进程 import 依赖。显式
    指定 ARGO_PYTHON 时不查也不写缓存——用户的覆盖是权威，不该被缓存遮蔽，
    也不该把它固化下来。
    """
    env_py = os.environ.get("ARGO_PYTHON", "").strip()
    if env_py:
        p = shutil.which(env_py) if not os.path.isabs(env_py) else env_py
        if p and _probe_python(p, True):
            return p
    else:
        cached = _cached_python()
        if cached:
            return cached

    cands = ["python3.14", "python3.13", "python3.12",
             "python3.11", "python3.10", sys.executable,
             # Windows：本机没有 `python3` 这个名字（上游 v2.8.5 的社区贡献已经
             # 在 node 启动器里按平台分流，这里是 `bin/argo` 自身的对应分支）。
             # `py` 是官方启动器，`py -3` 取最新 3.x；解析成真实路径后才入库。
             ["py", "-3"], ["py"], "python3", "python", "python3.exe", "python.exe"]
    for cand in cands:
        if isinstance(cand, str):
            if not cand:
                continue
            py = cand if os.path.isabs(cand) else shutil.which(cand)
        else:
            launcher = shutil.which(cand[0])
            py = _resolve_launcher([launcher] + list(cand[1:])) if launcher else ""
        if not py:
            continue
        if _probe_python(py, True):
            if not env_py:
                _remember_python(py)
            return py
    return sys.executable


def _self_capable() -> bool:
    """当前解释器是否已满足 argo 的运行要求（版本 + 依赖），进程内判定。

    与 _probe_python 的分工：那个要 spawn 一个 python 进程才问出一句话，
    这个只查 importlib 的 find_spec，零子进程。

    为什么需要它：shebang 是 `#!/usr/bin/env python3`，在装了高版本 python
    的机器上（如 homebrew 3.14）落到的往往就是 _pick_python 会选中的那个
    解释器。此时「探测一遍 + execv 重启」纯粹是把同一个解释器再启一次，
    每次调用白付一次进程启动与一次校验子进程。达标就地执行即可。

    依赖口径与 _PY_CHEAP_CHECK / _probe_python 完全一致：只认 PyYAML 这一个
    必需第三方依赖。这里曾多要求 requests，但全仓没有任何 `import requests`
    （它是早已移除的幽灵依赖，可选增强是 curl_cffi）。多要求一个用户机器上
    不存在的包，会让本函数在「照 install.sh 只装了 pyyaml」的正常环境里恒为
    False，于是每次调用都被迫重选解释器并 execv 重启——本该省掉的重复启动，
    在所有终端用户机器上静默失效，只在恰好装了 requests 的开发机上才生效。
    """
    if sys.version_info < (3, 10):
        return False
    import importlib.util as _util
    return _util.find_spec("yaml") is not None


def _engine_count():
    """收录的引擎数（config.yaml + engines/specs/*.yaml 合并口径，单一真源）。

    只报「收录数」这个便宜且不随环境变的数：以前这里报的是「启用数」，
    既与文档里的收录数对不上，配置不可读时还回退到一个写死的旧值（87），
    用户看到的是个假数字。真读不出来就不显示数量，别编。
    """
    try:
        sys.path.insert(0, SCRIPTS)
        from config import load_config
        engines = load_config().get("engines") or {}
        return len([k for k, v in engines.items() if isinstance(v, dict)]) or None
    except Exception:
        return None


def _version():
    """版本号：唯一真源是 package.json（本文件不存副本，防再添一处漂移点）。

    此前 `argo --version` 落进「Unknown subcommand」——连「报版本」这个最
    基础的环境探针都没有。只在本分支读 package.json（一次性小文件），不碰
    scripts/ 里的重模块。
    """
    try:
        import json
        with open(os.path.join(ARGO_HOME, "package.json")) as f:
            return "argo " + str(json.load(f).get("version") or "unknown")
    except Exception:
        return "argo unknown（package.json 不可读）"


def _usage() -> str:
    n = _engine_count()
    head = f"{n} 个源" if n else "多源"
    # 花括号在 f-string 里是替换字段语法：字面量花括号必须写成 {{ }}，
    # 漏写会抛 NameError（{status|inject|undo} 曾让 --help 直接崩溃）。
    return f"""argo — 统一搜索与证据核验 CLI（收录 {head}）

Usage:
  argo search    "query"          统一搜索（{head}，TF-IDF路由+RRF融合）
  argo research  "query"          深度研究（问题分解→多源采集→综合报告）
  argo evidence  "query"          可信度评估（自动搜索 → 评分，或 pipe 搜索结果）
  argo clarify   "query"          意图消歧（歧义检测+意图分类+路由建议）
  argo fetch     "url"            抓取单页正文（多级降级：md 变体→HTTP→TLS 指纹→jina→Parallel 免费云渲染→浏览器）
  argo crawl     "url"            站点爬取（sitemap/BFS，多页抓取）
  argo extract   "url"            结构化提取（表格/Meta/JSON-LD）
  argo article   "url"            微信公众号文章全文抓取（标题/正文/图片）
  argo screenshot "url"           网页截图（--full-page 整页 / --output 指定路径）
  argo pdf       "url"            PDF 正文提取（--pages 1-5 / --password 口令）
  argo answer    "query"          直答（Seltz 带引用合成答案，置信口径=引用计数）
  argo watch     {{add|check|list|remove}}  观察模式（网页快照与变化检测，cron 可用）
  argo job       "query"          招聘岗位多平台聚合（BOSS/猎聘/智联/前程无忧/597/今日招聘）
  argo preflight "url1 url2 ..."  批量 URL 预检（登录墙/已死/已归档分类，--probe 联网探测）
  argo mcp       {{status|inject|undo}}   多客户端 MCP 一键注入/诊断/还原

Common flags: --json --mode {{fast|auto|deep|budget}} --max-results N --depth {{fast|balanced|deep}}

本机此刻可用几个源：argo search --list-engines --routable-only
逐源费用/密钥/状态：docs/ENGINE_CATALOG.md
"""

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(_usage())
        # 帮助不是错误：--help/help 正常退出（0），无参数调用才是用法错误（1）
        sys.exit(0 if len(sys.argv) >= 2 else 1)

    if sys.argv[1] in ("--version", "-v", "version"):
        print(_version())
        sys.exit(0)

    sub = sys.argv[1]
    rest = sys.argv[2:]
    # 达标就地执行；否则按 _pick_python 选解释器并 execv 重启。
    # 判定前置于探测：达标时连 _pick_python 的子进程校验都省掉。
    inplace = _self_capable()
    py = sys.executable if inplace else _pick_python()

    # env 文件 → os.environ 同步（只填缺失，不覆盖已有值）：子进程按标准
    # os.environ 直读密钥（读取方零改动，含其他 AGT 既有集成），未经
    # mcp_launch.sh 注入的裸 shell 也能拿到
    try:
        sys.path.insert(0, SCRIPTS)
        from engine_env import sync_envfile_to_environ
        sync_envfile_to_environ()
    except Exception:
        pass

    scripts = {
        "search":    ("search.py",     ["--json"]),
        "research":  ("research.py",   ["--json"]),
        "evidence":  ("evidence.py",   ["--stdin", "--json"]),
        "clarify":   ("clarify.py",    ["--json"]),
        # fetch 对应 MCP 的 argo_fetch（正文抓取）：CLI 与 MCP 工具面保持一一对应，
        # 少一个入口就意味着该能力只能靠 MCP（默认关）或 --engine 绕路才够得着。
        "fetch":     ("fetch_v3.py",   []),
        "crawl":     ("crawl.py",      []),
        "extract":   ("extract.py",    []),
        "article":   ("article.py",    ["--json"]),
        # screenshot/pdf 对应 MCP 的 argo_screenshot / argo_pdf：CLI 与 MCP 工具面
        # 保持一一对应，少一个入口就意味着该能力只能靠 MCP（默认关）够得着
        "screenshot": ("screenshot.py", []),
        "pdf":        ("pdf_extract.py", []),
        # answer/watch：CLI 子命令（不进 MCP 工具面，工具数门禁口径不变）
        "answer":    ("answer.py",     ["--json"]),
        "watch":     ("watch.py",      []),
        "job":       ("job.py",        []),
        "preflight": ("batch_probe.py", []),
        "mcp":       ("mcp_setup.py",  []),
    }

    if sub not in scripts:
        print(f"Unknown subcommand: {sub}", file=sys.stderr)
        print(_usage(), file=sys.stderr)
        sys.exit(1)

    script, defaults = scripts[sub]
    path = os.path.join(SCRIPTS, script)

    # evidence: auto search → evidence pipeline (when no stdin data)
    # 用法查询（-h/--help）不走这条管道判定：它既没有查询词也没有 stdin，
    # 会被当成「用错了」报错并 exit 1——查用法却拿到失败码，脚本里
    # `argo evidence --help || fallback` 会走错分支（2026-09-15 实测）。
    # 交给通用执行路径，由 evidence.py 自己的 argparse 输出帮助并 exit 0。
    if sub == "evidence" and not any(a in ("-h", "--help") for a in rest):
        # 判据必须是 fd 类型而非 isatty()：非交互环境（脚本/CI/cron/agent）的
        # 空 stdin 也不是 tty，用 isatty 会把「无数据」判成「有数据」，让
        # `argo evidence "query"` 走进读管道分支后崩在 json.load 上。
        sys.path.insert(0, SCRIPTS)
        try:
            from cli_io import read_stdin_if_piped
        except ImportError:  # 脚本目录不可导入时按「无管道数据」处理，不猜
            read_stdin_if_piped = lambda: ""  # type: ignore[assignment]
        stdin_text = read_stdin_if_piped()
        query = rest[0] if rest and not rest[0].startswith("-") else ""

        if not stdin_text.strip() and query:
            # 自动搜索 → 管道 → evidence
            search_path = os.path.join(SCRIPTS, "search.py")
            search_cmd = [py, search_path, query, "--json",
                          "--mode", "fast", "--max-results", "10"]
            result = subprocess.run(search_cmd, capture_output=True, text=True, timeout=30)
            if result.returncode != 0:
                print(result.stderr, file=sys.stderr)
                sys.exit(result.returncode)
            stdin_text = result.stdout

        if stdin_text.strip():
            # 管道模式：stdin → evidence（内容已读出，用 input= 转发给子进程）
            evidence_args = defaults + rest
            proc = subprocess.run([py, path] + evidence_args, input=stdin_text,
                                  capture_output=True, text=True, timeout=60)
            print(proc.stdout, end="")
            if proc.stderr:
                print(proc.stderr, file=sys.stderr)
            sys.exit(proc.returncode)

        print("evidence 需要查询词。用法：argo evidence \"query\"", file=sys.stderr)
        sys.exit(1)

    # --explain 与 --json 冲突（explain 输出纯文本干扰 JSON），自动去 --json
    if "--explain" in rest and "--json" in defaults:
        defaults.remove("--json")

    args = defaults + rest
    if inplace:
        # 原地执行：省一次解释器启动，并复用本进程已 import 的模块。
        # runpy 会正确设置 __file__ / __name__，目标脚本的
        # `if __name__ == "__main__"` 分支照常触发，sys.exit 照常传播。
        #
        # run_module 而非 run_path：run_path 把源文件当「无名脚本」执行，每次
        # 重新编译（实测 search.py 113KB ≈ 13ms），`__pycache__` 永不命中；
        # run_module 走 importlib 的缓存校验，同一份源码只在首次或改动后编译。
        # SCRIPTS 已在 sys.path 首位，模块名即去掉 .py 的文件名。
        sys.argv = [path] + args
        sys.path.insert(0, SCRIPTS)
        import runpy
        runpy.run_module(script[:-3], run_name="__main__")
        return
    os.execv(py, [py, path] + args)

if __name__ == "__main__":
    main()
